     },
     {
      "who": "agent",
      "at": "optional-4",
      "text": {
       "en": "Then the narrator is optional: [[your character, a photo, a badge — or none]].",
       "ar": "يبقى الراوي اختياري: [[شخصيتك، صورة، شارة… أو من غير]]."
      }
     },
     {
      "who": "human",
      "at": "voice-4",
